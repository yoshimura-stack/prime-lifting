{
  "name": "prime-lifting",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://ctxhopadmvasxvjspwoi.supabase.co",
    "DAILY_REWARDS_TEST_PLAYER_ID": "15021678-6d37-40dd-97ab-9b6c61d15281",
    "DAILY_REWARDS_ENABLED": "true"
  },
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://ctxhopadmvasxvjspwoi.supabase.co"
    },
    "ratelimits": [
      {
        "name": "AUTH_LIMITER",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      },
      {
        "name": "API_LIMITER",
        "namespace_id": "1002",
        "simple": {
          "limit": 60,
          "period": 60
        }
      }
    ]
  }
}
