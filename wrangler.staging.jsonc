{
  "name": "prime-lifting-boost-staging",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://tarnzjkxexlozqqmyqof.supabase.co",
    "PRIME_BOOST_ENABLED": "true",
    "PRIME_BOOST_SCORE_PERSISTENCE_READY": "true",
    "DAILY_REWARDS_ENABLED": "true"
  }
}
